# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# CONFIGURAÇÃO DE ENVIO DE E-MAIL INSTITUCIONAL (SMTP)
# ==============================================================================
# Quando configurado, os e-mails de confirmação e códigos de ativação são 
# disparados fisicamente para a caixa de entrada corporativa do destinatário.
# Sem estas variáveis, o sistema opera no modo sandbox/simulação (código na tela).
#
# Exemplo 1: Servidor SMTP da Prefeitura / IPME
# SMTP_HOST="smtp.eusebio.ce.gov.br"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="atendimento@ipmeusebio.ce.gov.br"
# SMTP_PASS="sua_senha_smtp"
# SMTP_FROM="\"IPME - Instituto de Previdência de Eusébio\" <atendimento@ipmeusebio.ce.gov.br>"
#
# Exemplo 2: Google Workspace / Gmail (usando Senha de App de 16 caracteres)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="notificacoes.ipme@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# SMTP_FROM="\"IPME - Junta Médica Oficial\" <notificacoes.ipme@gmail.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
